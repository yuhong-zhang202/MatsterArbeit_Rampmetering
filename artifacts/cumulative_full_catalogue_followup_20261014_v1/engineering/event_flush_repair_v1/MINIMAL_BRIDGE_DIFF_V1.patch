+def _flush_observed_events(adapter, producer, output, cursors):
+    """Persist only existing events; retain each successful row's cursor."""
+    for key, events, filename in (
+        ('command', adapter.ledger.events, 'command_events.jsonl'),
+        ('feedback', producer.events, 'feedback_events.jsonl')):
+        while cursors[key] < len(events):
+            append_new(output/filename, events[cursors[key]])
+            cursors[key] += 1
+
+
+def _retain_reconcile_stop(adapter, producer, output, cursors, stop_row, original):
+    """Durable observed events on STOP, without masking the original failure."""
+    try:
+        _flush_observed_events(adapter, producer, output, cursors)
+        append_new(output/'post_steps.jsonl', stop_row)
+    except Exception as logging_error:
+        detail = {'status':'UNKNOWN_STOP_EVENT_LOGGING',
+            'original_stop':type(original).__name__+':'+str(original),
+            'logging_error':type(logging_error).__name__+':'+str(logging_error),
+            'successful_row_cursors':dict(cursors),
+            'command_events_created':len(adapter.ledger.events),
+            'feedback_events_created':len(producer.events),
+            'uncertain_write_not_retried':True,'no_additional_motion':True}
+        detail_error = ''
+        try:
+            with (output/'stop_event_logging_failure.json').open('x') as file:
+                file.write(json.dumps(detail,allow_nan=False)+'\n')
+                file.flush();os.fsync(file.fileno())
+        except Exception as record_error:
+            detail_error = ';error_record_unknown:'+type(record_error).__name__+':'+str(record_error)
+        raise RuntimeError('UNKNOWN_STOP_EVENT_LOGGING;original='+detail['original_stop']+
+            ';logging='+detail['logging_error']+detail_error) from original
+
