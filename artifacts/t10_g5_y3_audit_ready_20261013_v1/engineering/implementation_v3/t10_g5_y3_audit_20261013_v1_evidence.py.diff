+    need(len(journal)==2*last+(len(pre)-last),'IDENTITY_JOURNAL_ACK_COVERAGE')
+    for i in range(last):
+        identity_journal(journal[2*i],i,'BEFORE_MOTION',pre[i]['bound_snapshot']['world'])
