# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
coverage.xml
htmlcov/

# Python virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Generated simulation data
data/raw/**
!data/raw/.gitkeep
/artifacts/stage2_completion_*/runtime_archive/

# Generated processed data
data/processed/**
!data/processed/.gitkeep

# Generated result tables and figures
results/tables/**
!results/tables/.gitkeep
results/figures/**
!results/figures/.gitkeep

# Dashboard dependencies and local runtime caches
dashboard/**/node_modules/
dashboard/**/.sites-runtime/
dashboard/**/.wrangler/
